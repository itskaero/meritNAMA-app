{
  "name": "meritnama-app",
  "version": "0.1.0",
  "private": true,
  "description": "MeritNama private application: candidate portal, admin workspace, induction data and simulation.",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
