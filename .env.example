# MeritNama app — environment template. Copy to .env and fill in.
# Placeholders only. Never commit a real .env.

# ── Database ───────────────────────────────────────────────
POSTGRES_USER=meritnama
POSTGRES_DB=meritnama
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# Used by `npm run dev` / `npm run db:migrate` on your machine (docker-compose.dev.yml exposes 5432 on localhost).
# In docker-compose.yml the app builds its own URL pointing at the `db` service.
DATABASE_URL=postgres://meritnama:change-me@localhost:5432/meritnama

# ── Application ────────────────────────────────────────────
# Public URL people use to reach the app (behind your reverse proxy or tunnel).
# Sign-in links and Google's redirect are built from it, so it must be exact: https, no trailing slash.
APP_URL=https://meritnama.online
# The domain alone, for the Caddy proxy profile (it also redirects www. to it).
MERITNAMA_DOMAIN=meritnama.online
# The public website's origin, allowed to call /api/health for its availability notice.
PUBLIC_SITE_ORIGIN=https://itskaero.github.io

# ── Sign-in (email one-time links) ─────────────────────────
# SMTP server that sends sign-in links. Required in production.
# Without it in development, mail lands in the dev mailbox at /dev/mailbox.
# Gmail: turn on 2-Step Verification for the account, create an App Password
# (Google Account → Security → App passwords), and write the address with %40 for @:
SMTP_URL=smtps://namamerit%40gmail.com:YOUR16CHARAPPPASSWORD@smtp.gmail.com:465
# Gmail sends as the account itself, so the From address must be that Gmail address.
MAIL_FROM="meritNAMA <namamerit@gmail.com>"
# Comma-separated emails that become owners the first time they sign in.
OWNER_EMAILS=you@example.org

# Optional "Continue with Google". Create an OAuth client (type: Web application) in
# Google Cloud Console → APIs & Services → Credentials, with the authorised redirect URI
#   <APP_URL>/auth/google/callback
# Set both or neither; the button only shows when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Candidate matching ─────────────────────────────────────
# Key for the HMACs of candidates' emails and PMDC numbers (raw values are never stored).
# Generate with: openssl rand -base64 48 | tr -d '/+='   — keep it; changing it means
# running `npm run index:candidates -- <folder of round files>` again.
CANDIDATE_INDEX_SECRET=

# ── Background worker ──────────────────────────────────────
# Shared secret between the app and the worker container (background jobs).
# Generate with: openssl rand -base64 48 | tr -d '/+='
INTERNAL_TOKEN=

# Optional: a fine-grained read-only token, to sync a PRIVATE data repository from Admin > Data.
GITHUB_TOKEN=

# ── NAS paths (docker-compose.yml) ─────────────────────────
# Host directory that holds ALL persistent state: postgres/, storage/, backups/.
MERITNAMA_DATA_DIR=./var
# Host port the app listens on. Bound to 127.0.0.1 by default — put a reverse proxy in front.
APP_PORT=3000

# ── Cloudflare Tunnel (only with `--profile tunnel`) ───────
# Token of the tunnel you create in Cloudflare Zero Trust → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Development only ───────────────────────────────────────
# Preview guarded routes before real auth exists: candidate | data_editor | policy_editor |
# verifier | moderator | owner ("admin" still works and means owner).
# Refused at startup when NODE_ENV=production.
DEV_AUTH_STUB_ROLE=
